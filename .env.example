# Required: Sarvam STT (used by transcribe-service for audio + YouTube)
SARVAM_API_KEY=

# Required: Gemini (used for analysis: extract claims, factcheck w/ search grounding, fallacies)
GEMINI_API_KEY=

# Optional overrides
DEBATELENS_SERVICE_URL=http://localhost:8080
DEBATELENS_GEMINI_MODEL_FAST=gemini-2.0-flash
DEBATELENS_GEMINI_MODEL_PRO=gemini-2.5-pro
DEBATELENS_OUT_DIR=./output

# Optional: only if you want to use the Google Cloud STT engine
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=asia-southeast1
# GOOGLE_APPLICATION_CREDENTIALS=
